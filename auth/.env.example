# Copy to auth/.env.local for local overrides. Same Postgres as the product API.
APP_ENV=development
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zivo:zivo@localhost:5455/zivo
SECRET_KEY=dev-secret-change-me
CSRF_SECRET=dev-csrf-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
SESSION_DAYS=7
SESSION_REMEMBER_DAYS=30
FRONTEND_URL=http://localhost:3000
# Shared apex+www session Domain (prod). Empty locally = host-only.
# COOKIE_DOMAIN=
# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local: Next rewrite keeps the callback on localhost:3000.
# Prod: https://auth.zivo.fyi/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
