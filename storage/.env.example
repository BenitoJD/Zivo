# Copy to storage/.env.local for local overrides. Same Postgres as the product API.
APP_ENV=development
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zivo:zivo@localhost:5455/zivo
SECRET_KEY=dev-secret-change-me
CSRF_SECRET=dev-csrf-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
MINIO_ENDPOINT=localhost:9020
MINIO_ACCESS_KEY=zivo
MINIO_SECRET_KEY=zivo-secret
MINIO_BUCKET=zivo-artifacts
MINIO_SECURE=false
MAX_UPLOAD_BYTES=1073741824
