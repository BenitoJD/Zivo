# Copy to backend/.env.local for local overrides.
APP_ENV=development
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zivo:zivo@localhost:6432/zivo
# Direct Postgres (bypass pooler): postgresql+psycopg://zivo:zivo@localhost:5455/zivo
SECRET_KEY=dev-secret-change-me
CSRF_SECRET=dev-csrf-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MINIO_ENDPOINT=localhost:9020
MINIO_ACCESS_KEY=zivo
MINIO_SECRET_KEY=zivo-secret
MINIO_BUCKET=zivo-artifacts
MINIO_SECURE=false
OPENAI_API_KEY=
OPENAI_API_BASE=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/coding/paas/v4
ZAI_ENABLED=true
STEPFUN_ENABLED=false
STEPFUN_API_KEY=
STEPFUN_API_BASE=https://api.stepfun.ai/step_plan/v1
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_POOL_ENABLED=true
# Router-backed model pool: the DB-default chat model is tried first; on rate
# limits / timeouts / 5xx it fails over to the next enabled model and cools the
# failing model down for ZIVO_ROUTER_COOLDOWN_SECONDS before re-trying it.
# Disable with ZIVO_ROUTER_ENABLED=0 to keep the manual failover loop.
ZIVO_ROUTER_ENABLED=1
ZIVO_ROUTER_COOLDOWN_SECONDS=120
ZIVO_ROUTER_ALLOWED_FAILS=3
ZIVO_ROUTER_RATE_LIMIT_RETRIES=3
# Offline Mode (ADR 0006): signed, server-tracked study packs. true = the
# "Prepare offline pack" affordance works and packs ship answer keys to the
# learner's own browser (short-lived + HMAC-signed). false = endpoint 404s.
OFFLINE_MODE_ENABLED=true
OFFLINE_PACK_TTL_DAYS=7
# Audiobook Engine: local Piper TTS (open-source, CPU-only). true = sources
# get a "Listen" player; PIPER_BIN may include args ("python -m piper").
AUDIOBOOK_ENABLED=false
PIPER_BIN=python -m piper
PIPER_VOICES_DIR=./piper_voices
# Page triage: false = instant paragraph/word heuristic (default). true = LLM plan.
LLM_PAGE_TRIAGE=false
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MAX_UPLOAD_BYTES=1073741824
STORAGE_LIMIT_BYTES=1073741824

# ETA workers — lease/heartbeat crash recovery.
# While a job runs, the worker renews its lease every ETA_HEARTBEAT_INTERVAL_SECONDS
# and the reaper treats a job as orphaned once its heartbeat is older than
# ETA_STALE_THRESHOLD_SECONDS. Defaults are tuned for LLM-heavy jobs and rarely
# need changing; raise ETA_LEASE_DURATION_SECONDS for very long single handlers.
# ETA_LEASE_DURATION_SECONDS=120
# ETA_HEARTBEAT_INTERVAL_SECONDS=15
# ETA_STALE_THRESHOLD_SECONDS=90
# Legacy fallback cutoff for pre-migration rows with no lease; keep generous.
# ETA_STALE_RUNNING_TIMEOUT=600
# ETA_WORKER_POLL_INTERVAL=0.3
# ETA_CPU_WORKER_MAX_CONCURRENCY=4
# ETA_IO_CONCURRENCY=16

# Judge0 code sandbox (coding Run/Submit). Shared box — see infra/judge0/README.md.
# Prod sets judge0Url in infra/k8s/charts/api/values.yaml.
JUDGE0_URL=http://203.57.85.20:2358

# Google OAuth (optional — set in .env.local)
# Use the frontend origin for GOOGLE_REDIRECT_URI so the session cookie is set
# on the same host the browser talks to (Next rewrites /api → FastAPI locally).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# FRONTEND_URL=http://localhost:3000
# Shared apex+www session Domain (prod). Empty locally = host-only.
# COOKIE_DOMAIN=
# Newspaper Telethon ingest (optional locally)
# 1) Put secrets below. 2) Migrate (seeds The Hindu allowlist).
# 3) Admin /workspace/newspaper: channel_label=MyBookZon ENGLISH (PREMIUM),
#    channel_ref=Telegram peer id (prefer numeric; resolve once from dialogs).
# 4) Paper names: LLM classifies filenames (TH/…) → learns aliases; no hardcode.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=
