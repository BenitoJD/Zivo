# Copy to secrets.yml (gitignored) and fill in. Generate randoms with: openssl rand -hex 16
zivo_secrets:
  POSTGRES_USER: zivo
  POSTGRES_PASSWORD: change-me
  SECRET_KEY: change-me
  CSRF_SECRET: change-me
  MINIO_ROOT_USER: zivo-minio
  MINIO_ROOT_PASSWORD: change-me
  MINIO_ACCESS_KEY: zivo
  MINIO_SECRET_KEY: change-me
  MINIO_BUCKET: zivo-artifacts
  LITELLM_MODEL: openai/step-3.7-flash
  DEEPSEEK_API_KEY: ""
  DEEPSEEK_API_BASE: https://api.deepseek.com/v1
  ZAI_API_KEY: ""
  ZAI_API_BASE: ""
  STEPFUN_API_KEY: ""
  STEPFUN_API_BASE: ""
  OPENROUTER_API_KEY: ""
  OPENROUTER_API_BASE: https://openrouter.ai/api/v1
  OPENAI_API_KEY: ""
  OPENAI_API_BASE: ""
  TELEGRAM_API_ID: ""
  TELEGRAM_API_HASH: ""
  TELEGRAM_SESSION: ""
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
judge0_redis_password: change-me
judge0_postgres_password: change-me

# GitHub token with read:packages scope; the cluster's ghcr-pull dockerconfigjson
# is built from it (app_releases role) so private GHCR packages stay pullable.
# Rotate by editing secrets.yml and re-running the app_releases tag.
ghcr_pull_token: ""
