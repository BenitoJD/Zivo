# Copy to group_vars/all/secrets.yml (gitignored) and fill in. Generate randoms with: openssl rand -hex 16
zivo_secrets:
  POSTGRES_USER: zivo
  POSTGRES_PASSWORD: change-me
  SECRET_KEY: change-me
  CSRF_SECRET: change-me
  MINIO_ROOT_USER: zivo-minio
  MINIO_ROOT_PASSWORD: change-me
  MINIO_ACCESS_KEY: zivo
  MINIO_SECRET_KEY: change-me
  MINIO_BUCKET: zivo-artifacts
  LITELLM_MODEL: openai/step-3.7-flash
  DEEPSEEK_API_KEY: ""
  DEEPSEEK_API_BASE: https://api.deepseek.com/v1
  ZAI_API_KEY: ""
  ZAI_API_BASE: ""
  STEPFUN_API_KEY: ""
  STEPFUN_API_BASE: ""
  OPENROUTER_API_KEY: ""
  OPENROUTER_API_BASE: https://openrouter.ai/api/v1
  OPENAI_API_KEY: ""
  OPENAI_API_BASE: ""
  TELEGRAM_API_ID: ""
  TELEGRAM_API_HASH: ""
  TELEGRAM_SESSION: ""
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  GRAFANA_ADMIN_USER: "admin"
  GRAFANA_ADMIN_PASSWORD: "change-me"

# Judge0 sandbox stack on worker-5.
judge0_redis_password: change-me
judge0_postgres_password: change-me

# Argo CD (gitops role): admin UI password and the repo credential it uses to
# clone the private repo. A fine-grained PAT with Contents: read on Zivo is
# enough; classic needs the repo scope.
argocd_admin_password: change-me
gh_repo_user: change-me
gh_repo_token: ""

# GHCR pulls: the cluster's ghcr-pull secret is applied and rotated manually
# (kubectl -n zivo create secret docker-registry ghcr-pull --docker-server=ghcr.io
# --docker-username=<user> --docker-password=<read:packages token> --dry-run=client
# -o yaml | kubectl apply -f -). Pipeline pushes use the ghcr environment's GitHub
# App instead, so no pull PAT is needed here.
