{% raw -%}
#!/usr/bin/env bash
# Docker disk hygiene for the self-hosted Actions runner box.
# Invoked by docker-cleanup.timer (see gh_runner_cleanup role) and safe to run
# by hand. Keeps the newest KEEP_TAGS Zivo release tags per repository so a
# rollback target always exists, caps the BuildKit cache so rebuilds stay warm,
# and reclaims orphaned CI volumes (judge0 volumes are in use and untouched).
set -uo pipefail

KEEP_TAGS="${KEEP_TAGS:-3}"

# The cicd pipeline creates this flag while docker builds are in flight so a
# nightly prune never lands mid-build. A flag younger than 4h means a build is
# (probably) running: skip. Older than 4h means a run died hard and left it
# behind: self-heal by removing it and cleaning as usual.
GUARD=/home/github-runner/.deploy-in-progress
if [ -f "$GUARD" ]; then
  if [ -n "$(find "$GUARD" -mmin +240 -print 2>/dev/null)" ]; then
    echo "stale deploy guard (>4h old) - removing and continuing"
    rm -f "$GUARD"
  else
    echo "build in progress (guard present) - skipping cleanup"
    exit 0
  fi
fi

echo "== docker cleanup start $(date -Is) =="

# 1. Old Zivo release tags: keep the newest KEEP_TAGS per repository.
#    Covers every tag scheme the pipeline has used: legacy Zivo_0.1.N,
#    semver (1.2.4), and branch builds (sha-abc1234). The repo filter keeps
#    base images (python, node, pgvector) out of the sweep.
mapfile -t old_images < <(docker images --format '{{.Repository}} {{.Tag}} {{.CreatedAt}}' \
  | awk -v keep="$KEEP_TAGS" '
    $1 ~ /(^|\/)zivo-/ &&
    ($2 ~ /^Zivo_[0-9]/ || $2 ~ /^v?[0-9]+\.[0-9]+\.[0-9]+$/ || $2 ~ /^sha-[0-9a-f]{7,40}$/) {
      count[$1]++
      if (count[$1] > keep) print $1 ":" $2
    }')
if ((${#old_images[@]} > 0)); then
  echo "removing ${#old_images[@]} old release tags:"
  printf '  %s\n' "${old_images[@]}"
  docker rmi -f "${old_images[@]}" >/dev/null 2>&1 || true
fi

# 2. Dangling images + exited containers.
docker container prune -f >/dev/null
docker image prune -f >/dev/null

# 3. BuildKit cache: keep a warm floor for fast builds, drop the excess.
docker builder prune -f --keep-storage "${KEEP_BUILDER_GB:-8}GB" >/dev/null

# 4. Orphaned volumes (CI postgres leftovers; attached volumes are skipped).
docker volume prune -f >/dev/null

echo "== docker cleanup done $(date -Is) =="
df -h / | tail -1
{%- endraw %}
