apiVersion: v1
kind: Secret
metadata:
  name: zivo-secrets
  namespace: zivo
type: Opaque
stringData:
  POSTGRES_USER: "{{ zivo_secrets.POSTGRES_USER }}"
  POSTGRES_PASSWORD: "{{ zivo_secrets.POSTGRES_PASSWORD }}"
  DATABASE_URL: "postgresql+psycopg://{{ zivo_secrets.POSTGRES_USER }}:{{ zivo_secrets.POSTGRES_PASSWORD }}@pgbouncer:5432/zivo"
  DATABASE_URL_DIRECT: "postgresql+psycopg://{{ zivo_secrets.POSTGRES_USER }}:{{ zivo_secrets.POSTGRES_PASSWORD }}@postgres:5432/zivo"
  MINIO_ROOT_USER: "{{ zivo_secrets.MINIO_ROOT_USER }}"
  MINIO_ROOT_PASSWORD: "{{ zivo_secrets.MINIO_ROOT_PASSWORD }}"
  MINIO_ACCESS_KEY: "{{ zivo_secrets.MINIO_ACCESS_KEY }}"
  MINIO_SECRET_KEY: "{{ zivo_secrets.MINIO_SECRET_KEY }}"
  MINIO_ENDPOINT: "minio:9000"
  MINIO_BUCKET: "{{ zivo_secrets.MINIO_BUCKET }}"
  MINIO_SECURE: "false"
  APP_ENV: "production"
  CORS_ORIGINS: "https://zivo.fyi,https://www.zivo.fyi"
  SECRET_KEY: "{{ zivo_secrets.SECRET_KEY }}"
  CSRF_SECRET: "{{ zivo_secrets.CSRF_SECRET }}"
  LITELLM_MODEL: "{{ zivo_secrets.LITELLM_MODEL }}"
  LLM_POOL_ENABLED: "true"
  DEEPSEEK_API_KEY: "{{ zivo_secrets.DEEPSEEK_API_KEY }}"
  DEEPSEEK_API_BASE: "{{ zivo_secrets.DEEPSEEK_API_BASE }}"
  ZAI_API_KEY: "{{ zivo_secrets.ZAI_API_KEY }}"
  ZAI_API_BASE: "{{ zivo_secrets.ZAI_API_BASE }}"
  ZAI_ENABLED: "true"
  STEPFUN_API_KEY: "{{ zivo_secrets.STEPFUN_API_KEY }}"
  STEPFUN_API_BASE: "{{ zivo_secrets.STEPFUN_API_BASE }}"
  STEPFUN_ENABLED: "true"
  OPENROUTER_API_KEY: "{{ zivo_secrets.OPENROUTER_API_KEY }}"
  OPENROUTER_API_BASE: "{{ zivo_secrets.OPENROUTER_API_BASE }}"
  OPENAI_API_KEY: "{{ zivo_secrets.OPENAI_API_KEY }}"
  OPENAI_API_BASE: "{{ zivo_secrets.OPENAI_API_BASE }}"
  TELEGRAM_API_ID: "{{ zivo_secrets.TELEGRAM_API_ID }}"
  TELEGRAM_API_HASH: "{{ zivo_secrets.TELEGRAM_API_HASH }}"
  TELEGRAM_SESSION: "{{ zivo_secrets.TELEGRAM_SESSION }}"
  GOOGLE_CLIENT_ID: "{{ zivo_secrets.GOOGLE_CLIENT_ID }}"
  GOOGLE_CLIENT_SECRET: "{{ zivo_secrets.GOOGLE_CLIENT_SECRET }}"
  GOOGLE_REDIRECT_URI: "https://auth.zivo.fyi/api/auth/google/callback"
  FRONTEND_URL: "https://zivo.fyi"
  COOKIE_DOMAIN: "zivo.fyi"
  GRAFANA_ADMIN_USER: "{{ zivo_secrets.GRAFANA_ADMIN_USER }}"
  GRAFANA_ADMIN_PASSWORD: "{{ zivo_secrets.GRAFANA_ADMIN_PASSWORD }}"
