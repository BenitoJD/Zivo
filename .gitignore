frontend/dist/
frontend/.next/
*.tsbuildinfo

# Docker / local data
pgdata/

# Test / tooling output
.coverage
htmlcov/
test-results/
playwright-report/
output/

# Cursor editor debug snapshots (keep config, ignore artifacts)
.cursor/*.png
.cursor/*.txt
.claude/settings.local.json
backend/.telegram_login_state
backend/.telegram_login_session

# Agent / coding-assistant session artifacts (plans, memories, rollouts).
