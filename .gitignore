.zcode/
.zcode/plans/
.zcode/memories/

# Next.js Turbopack cache (Next 16 default bundler)
.turbo/
next-env.d.ts
backend/piper_voices/
# graphify regenerable cache (graph.json + skill are committed)
graphify-out/cache/
graphify-out/cost.json
